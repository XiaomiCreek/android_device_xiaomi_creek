type charger_vendor, domain;

r_dir_file(charger_vendor, sysfs_batteryinfo)
r_dir_file(charger_vendor, sysfs_type)
r_dir_file(charger_vendor, sysfs_usb_supply)
r_dir_file(charger_vendor, sysfs_battery_supply)
r_dir_file(charger_vendor, gpu_device)

# Allow charger to access graphics for charging animation
allow charger_vendor graphics_device:dir search;
allow charger_vendor graphics_device:chr_file rw_file_perms;
allow charger_vendor dri_device:chr_file rw_file_perms;

# Allow charger to read input events (power key / charger plug)
allow charger_vendor input_device:dir r_dir_file_perms;
allow charger_vendor input_device:chr_file r_file_perms;

# Allow wakelocks and system properties
wakelock_use(charger_vendor)
get_prop(charger_vendor, hw_rev_prop)

# Keep userdebug/eng safety net if needed
userdebug_or_eng(`
    permissive charger;
    permissive charger_vendor;
')
