cc_library_shared {
    name: "libcodec2_legacy_fence_shim",
    vendor: true,
    compile_multilib: "both",
    srcs: ["LegacyFenceShim.cpp"],
    header_libs: [
        "libcodec2_headers",
        "libhardware_headers",
    ],
    shared_libs: ["libcodec2_vndk"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
